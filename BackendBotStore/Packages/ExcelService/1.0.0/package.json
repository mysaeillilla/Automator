{
  "PackageName": "ExcelService.dll",
  "Version": "1.0.0",
  "Dependencies": "ClosedXML.dll,ClosedXML.Parser.dll,DocumentFormat.OpenXml.dll,DocumentFormat.OpenXml.Framework.dll,ExcelNumberFormat.dll",
  "Actions": [
    {
      "ActionName": "GetSheetNames",
      "Inputs": {
        "filePath": "STRING"
      },
      "Outputs": {
        "Response": "LIST"
      }
    },
    {
      "ActionName": "ReadExcel",
      "Inputs": {
        "filePath": "STRING",
        "sheetName": "STRING"
      },
      "Outputs": {
        "Response": "DATATABLE"
      }
    },
    {
      "ActionName": "WriteExcel",
      "Inputs": {
        "dataTable": "DATATABLE",
        "filePath": "STRING",
        "sheetName": "STRING"
      },
      "Outputs": {
        "Response": "STRING"
      }
    }
  ]
}