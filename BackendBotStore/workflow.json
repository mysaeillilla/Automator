{
  "flow_name": "Excel Reader",
  "version": "1.0.0",
  "packages": {
    "ExcelOperations": ""
  },
  "variables": {
    "file_Path": {
      "value": "C:\\Users\\Admin\\Downloads\\Leave_Request_Automation.xlsx",
      "type": "STRING",
      "input": true,
      "output": false
    },
    "sheet_name": {
      "value": "Business Process",
      "type": "STRING",
      "input": true,
      "output": false
    },
    "df_Employee_data": {
      "value": [],
      "type": {
        "id": "NUMBER",
        "Employee Name": "STRING",
        "Age": "NUMBER"
      },
      "input": false,
      "output": true
    }
  },
  "Actions": {
    "1": {
      "ClassName": "ExcelTools.ExcelReader",
      "FunctionName": "ReadExcel",
      "Inputs": {
        "filePath": "{{file_Path}}",
        "sheetName": "{{sheet_name}}",
        "headerStartRow": 1,
        "skipEmptyRows": true
      },
      "outputs": {
        "Response": "{{df_Employee_data}}"
      }
    }
  }
}